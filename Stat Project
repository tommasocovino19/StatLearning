```{r}
calculate_accuracy <- function(model_pred, true_labels) {
  model_pred <- factor(model_pred, levels = levels(factor(true_labels)))  # Allinea i livelli
  true_labels <- factor(true_labels)
  accuracy <- sum(model_pred == true_labels) / length(true_labels)
  return(accuracy)
}

# Calcolare Accuracy per ogni modello
