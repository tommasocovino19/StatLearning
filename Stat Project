# Creare una funzione per calcolare AUC
calculate_auc <- function(model_pred, true_labels) {
  pred_obj <- prediction(as.numeric(model_pred), as.numeric(true_labels))
  auc_value <- performance(pred_obj, "auc")@y.values[[1]]
  return(auc_value)
}

