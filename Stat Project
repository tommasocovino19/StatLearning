```{r}
calculate_metrics <- function(model_pred, true_labels) {
  model_pred <- factor(model_pred, levels = levels(factor(true_labels)))  # Allinea i livelli
  true_labels <- factor(true_labels)
  
  cm <- confusionMatrix(model_pred, true_labels)
  
  precision <- cm$byClass["Pos Pred Value"]  # Precision
  recall <- cm$byClass["Sensitivity"]  # Recall
  f1_score <- 2 * (precision * recall) / (precision + recall)  # F1-score
  
  return(c(precision, recall, f1_score))
}

# Calcolare le metriche per ogni modello
metrics_log <- calculate_metrics(log_pred_class, test_data$loan_approval)
metrics_rf <- calculate_metrics(rf_pred, test_data$loan_approval)
metrics_svm <- calculate_metrics(pred_svm, test_data$loan_approval)

# Estrarre i valori
precision_log <- metrics_log[1]
recall_log <- metrics_log[2]
f1_log <- metrics_log[3]

precision_rf <- metrics_rf[1]
recall_rf <- metrics_rf[2]
f1_rf <- metrics_rf[3]

precision_svm <- metrics_svm[1]
recall_svm <- metrics_svm[2]
f1_svm <- metrics_svm[3]

# Creare un dataframe con tutte le metriche
results <- data.frame(
  Model = c("Logistic Regression", "Random Forest", "SVM"),
  AUC = c(auc_log, auc_rf, auc_svm),
  Accuracy = c(acc_log, acc_rf, acc_svm),
  Precision = c(precision_log, precision_rf, precision_svm),
  Recall = c(recall_log, recall_rf, recall_svm),
  F1_Score = c(f1_log, f1_rf, f1_svm)
)

# Stampare i risultati
print(results)
